{
  "name": "com.wulato.uikit",
  "version": "0.4.0",
  "displayName": "Wulato UIKit",
  "unity": "2022.3",
  "unityRelease": "62f2",
  "dependencies": {
    "com.unity.ugui": "1.0.0",
    "com.cysharp.unitask": "2.5.11"
  },
  "samples": [
    {
      "displayName": "QuickStart",
